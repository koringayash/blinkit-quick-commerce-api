# --- Python bytecode, caches & test artifacts ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/

# --- Node / Frontend dependencies & build outputs ---
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.output/
frontend/.nitro/
frontend/.tanstack/
frontend/.vinxi/
frontend/.wrangler/
frontend/.dev.vars
*.tsbuildinfo

# --- Environment variables & secrets (keep .env.example tracked) ---
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Editor & OS files ---
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Build & logs ---
build/
dist/
*.egg-info/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

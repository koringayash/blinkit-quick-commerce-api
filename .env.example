# Copy to `.env` and adjust. docker compose reads it automatically.

# --- PostgreSQL ---
POSTGRES_USER=quickkart
POSTGRES_PASSWORD=quickkart
POSTGRES_DB=quickkart
POSTGRES_PORT=5432

# --- Published ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_DEV_PORT=8080

# --- Backend ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAILS=admin@quickkart.com
CORS_ORIGINS=*
ALLOWED_HOSTS=*
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=INFO
LOG_FORMAT=json
PAYMENT_GATEWAY=MOCK
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=mock_key_secret
RAZORPAY_WEBHOOK_SECRET=mock_webhook_secret
PAYMENT_TIMEOUT_MINUTES=15
ORDER_EXPIRY_SWEEP_SECONDS=60

# --- Frontend ---
# URL the browser uses to reach the API (baked into the frontend build)
VITE_API_BASE_URL=http://localhost:8000

